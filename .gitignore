# ============================================================
# Python
# ============================================================
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Python tooling caches (defensive, kept in case these tools are added later)
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
# Secrets and credentials:  NEVER COMMIT THESE
# ============================================================
.env
.env.*

# GCP service-account keys. The active key for this project lives outside
# the repo (in C:\Users\Elena\.gcp\), but these patterns catch the default
# GCP naming if a key ever gets dropped into the project folder by mistake.
*-credentials.json
*-service-account.json
service-account*.json
gcp-key*.json
nyt-bestsellers-*.json

# ============================================================
# Editor / IDE
# ============================================================
.vscode/
.cursor/
*.code-workspace

# ============================================================
# OS files
# ============================================================
.DS_Store
._*
Thumbs.db
desktop.ini

# ============================================================
# dbt
# ============================================================
# Compiled SQL, run artifacts, packages, and per-user config.
# These patterns also live in nyt_bestsellers/.gitignore (auto-generated by
# `dbt init`). Repeated here so they'd still apply if the dbt subproject
# was moved or renamed.
target/
dbt_packages/
logs/
.user.yml

# dbt profiles: environment-specific, never committed (may contain
# credentials in some setups; even when they don't, they're machine-specific).
**/profiles.yml

# ============================================================
# Logs
# ============================================================
*.log

# ============================================================
# Local automation (machine-specific, not for the public repo)
# ============================================================
# Helper scripts specific to this machine's local setup. Not part of the
# pipeline itself and not useful outside Elena's laptop.
scripts/

# ============================================================
# Personal / private working documents (not for the public repo)
# ============================================================
# Internal dashboard documentation, interview prep, draft mocks.
dashboard/

# Personal notes / planning documents.
Book Tracking Project.docx
*.docx
